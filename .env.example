# Single shared password used to enter the wiki.
WIKI_PASSWORD=

# Random string (>=16 chars) used to derive the session cookie value.
# Generate with: openssl rand -hex 32
WIKI_SESSION_SECRET=

# Mapbox public access token for interactive maps under /wiki/maps/*.
# Get one free at https://account.mapbox.com/access-tokens/
# Without this, map pages render a fallback message.
NEXT_PUBLIC_MAPBOX_TOKEN=
